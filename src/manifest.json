{
  "manifest_version": 3,
  "name": "cedarville self-service bridge",
  "version": "0.1.0",
  "description": "Lets the course planner read your own Self-Service data using your own session. Fetches only; stores and sends nothing.",
  "key": "",
  "host_permissions": ["https://selfservice.cedarville.edu/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "open the course planner"
  },
  "content_scripts": [
    {
      "matches": ["https://selfservice.cedarville.edu/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": ["http://localhost:5173/*"]
  }
}
