{
  "name": "the-cedarville-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "watch": "bun run build.ts --watch",
    "serve": "bun run serve.ts",
    "dev": "bun run build.ts && bun run serve.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check --write",
    "ci": "biome ci . && tsc --noEmit && bun test",
    "mcp": "bun src/mcp/server.ts",
    "mcp:personal": "bun src/mcp/server.ts --personal"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.0.268",
    "happy-dom": "^20.11.2",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  }
}
